# Copy this file to omni-agent/.env and fill in your real values.
# omni-agent/.env is gitignored - never commit the GPU server address or token.
#
# Values here override models.json at runtime. An already-exported shell
# environment variable always wins over this file.

# GPU server Ollama endpoint. Scheme is optional (http:// is assumed).
# Examples:
#   OMNI_OLLAMA_HOST=http://10.0.0.42:11434
#   OMNI_OLLAMA_HOST=gpu.internal.example:11434
OMNI_OLLAMA_HOST=

# Optional. Only needed if the server sits behind a reverse proxy that
# requires bearer auth. Sent as: Authorization: Bearer <token>
OMNI_OLLAMA_TOKEN=

# ---------------------------------------------------------------------------
# On the GPU server itself, Ollama must listen on all interfaces and should
# have flash attention + quantized KV cache enabled:
#
#   OLLAMA_HOST=0.0.0.0:11434
#   OLLAMA_FLASH_ATTENTION=1
#   OLLAMA_KV_CACHE_TYPE=q8_0
#   OLLAMA_NUM_PARALLEL=1
#
# Then pull the models used by models.json:
#   ollama pull huihui_ai/Qwen3.6-abliterated:35b-a3b-q4_K
#   ollama pull huihui_ai/Qwen3.6-abliterated:35b-Claude-4.7-q4_K
#   ollama pull huihui_ai/Qwen3.6-abliterated:27b-q4_K
# ---------------------------------------------------------------------------
